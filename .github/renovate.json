{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices"
  ],
  "minimumReleaseAge": "3 days",
  "osvVulnerabilityAlerts": true,
  "dependencyDashboardOSVVulnerabilitySummary": "all",
  "timezone": "Europe/Oslo",
  "customManagers": [],
  "packageRules": [
    {
      "description": "Update Home Assistant, its test plugin, Docker image and hacs.json together",
      "matchPackageNames": ["homeassistant", "pytest-homeassistant-custom-component", "ghcr.io/home-assistant/home-assistant"],
      "enabled": false
    }
  ]
}
